strict graph G {
    layout="neato"
    overlap="scale"
    /*
    00 -- 01 -- 10 -- 11
    00 -- 02 -- 20 -- 22
    00 -- 03 -- 30 -- 33
    00 -- 04 -- 40 -- 44
    00 -- 05 -- 50 -- 55
    */
    subgraph cluster_A { 
	rank = same;
	color="red";
	0 -- 1 -- 2 -- 3 -- 4 -- 5 -- { 00 01 10  11 }
	00 -- 11 -- 22 -- 33 -- 44 -- 55 -- { 000 010 011 100 101 110 111 }
	000 -- 111 -- 222 -- 333 -- 444 -- 555 -- Logic
	0000 -- 1111 -- 2222 -- 3333 -- 4444 -- 5555 -- 01111
	00000 -- 11111 -- 22222 -- 33333 -- 44444 -- 55555 -- 11111 
    }

    subgraph cluster_I { 
	rank = same;
	color="yellow";

	0 -- 2 -- 4 -- 1
	00 -- 22 -- 44 -- 11
	000 -- 222 -- 444 -- 111
	0000 -- 2222 -- 4444  -- 1111
	00000 -- 22222 -- 44444 -- 11111
    }
    subgraph cluster_O { 
	rank = same;
	color="violet";
	
	// 2⁵
	00000 -- { 00001 -- { 00010 -- { 00011 -- {
	    00100 -- { 00101 -- { 00110 -- { 00111 -- {
		01000 -- { 01001 -- { 01010 -- { 01011 -- {
		    01100 -- { 01101 -- { 01110 -- { 01111 -- {
