digraph Ziggurat {
    layout=neato
    size=<width=640;height=48;>
    margin=8
    dim=10
    dimen=10
    overlap=scale
    rankdir=BT
    start=<datetime>
    bgcolor=transparent;
    
    node [label=<00F\N>;style=filled;color=<lightblue:lightgrey>;bgcolor=<lightblue:lightgrey>;];
    edge [label=<\E>;color=<lightblue:lightgrey>;]
	
    subgraph nibur {
	node [label=<n=\N>;style=filled;color=<brown:grey>;bgcolor=<brown:grey>;];
	edge [label=<\E>;color=<brown:grey>;]

	<00000000> [label=<n⁸>;]
	<0000000> [label=<n⁷>;]
	<000000> [label=<n⁶>;]
	<00000> [label=<n⁵>;]
	<0000> [label=<n⁴>;]
	<000> [label=<n³>;]
	<00> [label=<n²>;]
	<0> [label=<n¹>;]
    }
    subgraph apex {
	node [label=<n=\N>;style=filled;color=<grey:brown>;bgcolor=<grey:brown>;];
	edge [label=<\E>;color=<grey:brown>;]
	
	<11111111> [label=<2⁸>;]
	<1111111>[label=<2⁷>;]
	<111111> [label=<2⁶>;]
	<11111> [label=<2⁵>;]
	<1111> [label=<2⁴>;]
	<111> [label=<2³>;]
	<11> [label=<2²>;]
	<1> [label=<2¹>;]
    }
    
    subgraph cluster_Omega {
	style=filled;
	bgcolor=<#00000078>;
	node [label=<n=\N>;style=filled;color=<pink:purple>;bgcolor=<pink:purple>;];
	edge [label=<&alefsym;\E;>;color=<pink:purple>;]
	<A> [label=<&spades;>]
	<AA> [label=<&hearts;>]
	<AAA> [label=<&clubs;>]
	<AAAA> [label=<&diams;>;fontsize=48;]
	
	<A> -> <Z>
	<AA> -> <ZZ>
	<AAA> -> <ZZZ>
	<AAAA> -> <ZZZZ>
    }

    
